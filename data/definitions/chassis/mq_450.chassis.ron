// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "mq_450",
    designator: "MQ-450",
    codename: "Panther",
    domain: Air,
    automatic_evasion_policy: On,
    launch_requires: [FlightDeck],
    recovery_requires: [FlightDeck],
    provides: [(facility: AirLaunch, cells: 4, max_simultaneous_launches: 4)],
    length: 14.0,
    weight: 1350.0,
    max_weight: 2550.0,
    max_fuel: 500.0,
    hit_points: 80.0,
    // Estimated: half the ~1 m drone fuselage height (#5193).
    full_damage_radius_m: 0.5,
    drag: 1.16,
    mast_height: 0.0,
    em_signatures: Some((rcs: 3.0, ir_base: 8.0, visual_cross_section: 0.8)),
    acoustic_signatures: None,
    physics: FixedWing(
        min_altitude: 100.0,
        max_altitude: 8000.0,
        default_altitude: 500.0,
        // Must stay `Some(0.0)` for as long as `target_domains` below names a
        // surface or land domain (#4125): the Attack clamp otherwise falls back
        // to `min_altitude`, holding the ram 100 m over its target, clear of
        // every warhead's fuze. Ordinary flight keeps the 100 m floor — this
        // bound applies to Attack navigation only, and only a warhead-carrying
        // build is ever issued one.
        min_attack_altitude: Some(0.0),
        max_attack_altitude: None,
        launch_speed: None,
        max_pitch_rate: 0.26,
        max_yaw_rate: 0.17,
        stall_speed: 50.0,
        max_lateral_g: 3.0,
        supported_trajectories: [Direct],
        terrain_clearance: 100.0,
    ),
    propulsion: Turbojet,
    // Thrust is sized for climb, not top speed (#3252). Thrust lapses with
    // air density and induced drag grows as the air thins, so the absolute
    // ceiling at MTOW (~9.3 km here) must clear `max_altitude` with margin or
    // the climb stalls out below it. The AEW reaches its 8,000 m ceiling ~13
    // min after leaving 500 m, an MTOW build ~19 min. Fuel burn is sized with
    // thrust (constant thrust-specific consumption), and `engine_bells` below
    // ask for the same absolute thrust at loiter, cruise and full, so only
    // the climb and the flank dash use the extra power.
    engine: Powered((thrust_n: 11500.0, fuel_burn_rate: 6.69, idle_burn_fraction: 0.10, thrust_response: AirDensity, thrust_schedule: BoostCoast)),
    allowed_components: [Category(Sensors), Category(Warheads), Category(Decoys), Category(Utility), Category(CarriedEntities)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: DeriveFromDomain,
    // What an ARMED MQ-450 can ram. Unarmed builds claim none of these (the
    // seeding in blueprint stats is warhead-conditional). Must not name
    // `Submarine` — an air hull cannot reach a submerged target — and must
    // move together with `min_attack_altitude` above.
    target_domains: [Air, SeaSurface, Land],
    guidance_uplink: None,
    battery_capacity_kwh: 1.0,
    base_power_draw_kw: 1.0,
    power_supply_kw: 30.0,
    engine_bells: (loiter: Some(0.112), cruise: Some(0.374), full: Some(0.598)),
)
