// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "rq_10",
    designator: "RQ-10",
    codename: "Jackal",
    domain: Air,
    automatic_evasion_policy: On,
    launch_requires: [FlightDeck],
    recovery_requires: [FlightDeck],
    // #3148: the RQ-10 is a scout / loitering-munition airframe — it rams with
    // its own warhead (target_domains below), it does not fire missiles. It
    // therefore provides no AirLaunch cells. (Charging AirLaunch's flat
    // $700k/cell here previously baked ~$2.8M into every RQ-10/AQ-10 design.)
    provides: [],
    length: 5.0,
    weight: 260.0,
    max_weight: 560.0,
    max_fuel: 200.0,
    hit_points: 20.0,
    // Estimated: half the ~0.5 m drone fuselage height (#5193).
    full_damage_radius_m: 0.25,
    drag: 0.33,
    mast_height: 0.0,
    em_signatures: Some((rcs: 0.1, ir_base: 3.0, visual_cross_section: 0.3)),
    acoustic_signatures: None,
    physics: FixedWing(
        min_altitude: 100.0,
        max_altitude: 5000.0,
        default_altitude: 500.0,
        // #3090: the terminal ram may dive all the way to the surface (the
        // same authorization every missile chassis carries). Ordinary flight
        // keeps the 100 m floor — this clamp applies to Attack navigation
        // only, and unarmed RQ-10 builds can never fly an Attack order.
        min_attack_altitude: Some(0.0),
        max_attack_altitude: None,
        launch_speed: None,
        max_pitch_rate: 0.44,
        max_yaw_rate: 0.26,
        stall_speed: 35.0,
        max_lateral_g: 4.0,
        // Existing player designs may select Lofted. A recoverable aircraft
        // without a fitted crossover executes that choice as Direct.
        supported_trajectories: [Direct, TerrainFollow, Lofted],
        terrain_clearance: 100.0,
    ),
    propulsion: Propeller,
    // Thrust is sized for climb, not top speed (#3252): the absolute ceiling
    // at MTOW (~7.4 km here) must clear `max_altitude` with margin, or
    // air-density thrust lapse and induced drag stall the climb out below it.
    // Every RQ-10 design reaches 5,000 m from 500 m in ~14-18 min. Fuel burn
    // is sized with thrust (constant thrust-specific consumption), and
    // `engine_bells` below ask for the same absolute thrust at loiter, cruise
    // and full, so only the climb and the flank dash use the extra power.
    engine: Powered((thrust_n: 1600.0, fuel_burn_rate: 4.8, idle_burn_fraction: 0.10, thrust_response: AirDensity, thrust_schedule: BoostCoast)),
    // #3148: no AirLaunch cells to deploy carried entities from, so the scout
    // chassis mounts sensors / its own warhead / utility only.
    allowed_components: [Category(Sensors), Category(Warheads), Category(Decoys), Category(Utility)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: DeriveFromDomain,
    // #3090: what an ARMED (warhead-carrying) RQ-10 can ram — a loitering
    // munition can dive on helicopters/drones, boats, and land targets.
    // Unarmed RQ-10 designs (scouts) claim none of these (warhead-conditional
    // seeding in blueprint stats).
    target_domains: [Air, SeaSurface, Land],
    guidance_uplink: None,
    battery_capacity_kwh: 0.5,
    base_power_draw_kw: 0.5,
    power_supply_kw: 3.0,
    engine_bells: (loiter: Some(0.075), cruise: Some(0.25), full: Some(0.475)),
)
