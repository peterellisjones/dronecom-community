// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "m_400",
    designator: "M-400",
    codename: "Pike",
    domain: Air,
    automatic_evasion_policy: Off,
    // VLS-only (#3082): a ship-magazine area-defence round, not a drone
    // hardpoint weapon — no AirLaunch, unlike every other missile.
    launch_requires: [VLS],
    recovery_requires: [],
    provides: [],
    length: 4.72,
    weight: 418.2908,
    // Ceiling: 174 kg of seeker and warhead on a full tank. The stock M-400A
    // carries 74 kg of that and flies at the SM-2-MR-class 708 kg gross mass.
    max_weight: 808.0,
    max_fuel: 215.7092,
    hit_points: 12.0,
    // Estimated: half the ~0.35 m missile body diameter (#5193).
    full_damage_radius_m: 0.18,
    drag: 0.030,
    mast_height: 0.0,
    em_signatures: Some((rcs: 0.08, ir_base: 16.0, visual_cross_section: 0.18)),
    acoustic_signatures: None,
    physics: FixedWing(
        min_altitude: 50.0,
        // High-altitude area defence: the M-400 exists to deny the AEW/scout
        // layer that loiters above the M-250's envelope.
        max_altitude: 20000.0,
        default_altitude: 100.0,
        min_attack_altitude: Some(0.0),
        max_attack_altitude: None,
        launch_speed: Some(250.0),
        max_pitch_rate: 0.90,
        max_yaw_rate: 0.45,
        stall_speed: 70.0,
        max_lateral_g: 40.0,
        supported_trajectories: [Direct, Lofted],
        terrain_clearance: 20.0,
    ),
    // SM-2-MR-class dual-thrust estimate (#5352): 50 kN boost at 1,176.6
    // kg/min consumes 98.0592 kg in 5.0005 s; 20 kN sustain at 470.6 kg/min
    // consumes 117.65 kg in 15 s at 40% thrust. Together the 215.7092 kg
    // tank delivers approximately 550 kN-s at an estimated 260 s Isp. The
    // 418.2908 kg chassis, 12 kg seeker and 62 kg class warhead close to the
    // approved 708 kg loaded mass. Reach is derived from measured physical
    // flyout.
    engine: Powered((thrust_n: 50000.0, fuel_burn_rate: 1176.6, idle_burn_fraction: 1.0, thrust_response: Constant, thrust_schedule: BoostSustain(boost_fuel_kg: 98.0592, sustain_thrust_fraction: 0.4, sustain_burn_rate: 470.6), signature: Rocket)),
    allowed_components: [Category(Sensors), Category(Warheads), Category(Utility), Category(CarriedEntities)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: Explicit(Missile),
    // Dedicated anti-air: unlike the multi-role M-250 this round only ever
    // commits on air tracks — the ladder's specialist tier.
    target_domains: [Air],
    guidance_uplink: FromLauncher,
    // Coast reserve sized to outlast the best-possible-range flight (same
    // rule as the M-100/M-250/M-300 guards, #2247/#2251/#2524) — verified by
    // the per-codename `munition_battery_reserve` guard from the VLS
    // (sea-level) launch geometry.
    battery_capacity_kwh: 0.6,
    base_power_draw_kw: 0.5,
    power_supply_kw: 1.1,
    engine_bells: (loiter: None, cruise: None, full: None),
)
