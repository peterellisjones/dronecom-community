// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "mq_220",
    designator: "MQ-220",
    codename: "Lynx",
    domain: Air,
    automatic_evasion_policy: On,
    launch_requires: [FlightDeck],
    recovery_requires: [FlightDeck],
    provides: [(facility: AirLaunch, cells: 6, max_simultaneous_launches: 6)],
    length: 10.0,
    weight: 650.0,
    max_weight: 1750.0,
    max_fuel: 250.0,
    hit_points: 45.0,
    drag: 0.52,
    mast_height: 0.0,
    em_signatures: Some((rcs: 1.0, ir_base: 5.0, visual_cross_section: 0.5)),
    acoustic_signatures: None,
    physics: FixedWing(
        min_altitude: 100.0,
        max_altitude: 5000.0,
        default_altitude: 500.0,
        // Must stay `Some(0.0)` for as long as `target_domains` below names a
        // surface or land domain (#4125): the Attack clamp otherwise falls back
        // to `min_altitude`, holding the ram 100 m over its target, clear of
        // every warhead's fuze. Ordinary flight keeps the 100 m floor — this
        // bound applies to Attack navigation only, and only a warhead-carrying
        // build is ever issued one.
        min_attack_altitude: Some(0.0),
        max_attack_altitude: None,
        launch_speed: None,
        max_pitch_rate: 0.35,
        max_yaw_rate: 0.21,
        stall_speed: 45.0,
        max_lateral_g: 9.0,
        supported_trajectories: [Direct],
        terrain_clearance: 100.0,
    ),
    propulsion: Turbojet,
    engine: Powered((thrust_n: 5400.0, fuel_burn_rate: 4.0, idle_burn_fraction: 0.10, thrust_response: AirDensity, thrust_schedule: BoostCoast)),
    allowed_components: [Category(Sensors), Category(Warheads), Category(Utility), Category(CarriedEntities)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: DeriveFromDomain,
    // What an ARMED MQ-220 can ram. Unarmed builds claim none of these (the
    // seeding in blueprint stats is warhead-conditional). Must not name
    // `Submarine` — an air hull cannot reach a submerged target — and must
    // move together with `min_attack_altitude` above.
    target_domains: [Air, SeaSurface, Land],
    guidance_uplink: None,
    battery_capacity_kwh: 1.0,
    base_power_draw_kw: 1.0,
    power_supply_kw: 10.0,
    engine_bells: (loiter: Some(0.15), cruise: Some(0.5), full: Some(0.8)),
)
