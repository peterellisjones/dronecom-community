// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
// #3704 (epic #3459): civilian neutral traffic — the fishing cluster's anchor.
// `ntds_classification: Explicit(CommandShip)` per the design doc's
// "carrier-plus-escort-screen silhouette" (AC2); sized well below the two
// `Explicit(CommandShip)` combatant hulls (`cv_1000` 90m, `cv_3000` 130m) so
// the classifier's CommandShip leaf keeps a decisive size separation — see
// `tests/scenarios/acceptance/features/civilian_roster.rs` for the measured
// convergence check.
(
    id: "autonomous_factory_trawler",
    designator: "AFT-100",
    codename: "Cannery",
    domain: Sea,
    automatic_evasion_policy: On,
    // #3704 code review: independent, director-spawned hull — see
    // `autonomous_cargo_ship.chassis.ron` for why `carrier: true` with empty
    // `launch_requires`/`recovery_requires` is correct and verified inert for
    // player exposure. `carrier: true` here has no bearing on the classifier
    // separation this file's header comment reasons about (it feeds the
    // structural launch-facility exception, carrier-selection UI, and a flat
    // pricing rider only — never `length`/`em_signatures`, the features the
    // classifier actually reads).
    launch_requires: [],
    recovery_requires: [],
    provides: [],
    length: 55.0,
    weight: 42000.0,
    max_weight: 55000.0,
    max_fuel: 5000.0,
    hit_points: 220.0,
    drag: 0.06,
    mast_height: 10.0,
    em_signatures: Some((rcs: 900.0, ir_base: 20.0, visual_cross_section: 60.0)),
    acoustic_signatures: Some((passive_noise: (base: 40000000.0, cavitation_speed: 10.0, quiet_slope: ServiceSpeed), sonar_cross_section: 200000000.0)),
    physics: SeaSurface(
        draft: 5.0,
        min_turn_rate_fraction: 0.3,
    ),
    propulsion: Screw,
    // #3704: zero `fuel_burn_rate` — see `autonomous_cargo_ship.chassis.ron`.
    engine: Powered((thrust_n: 133900.0, fuel_burn_rate: 0.0, idle_burn_fraction: 0.15, thrust_response: Constant, thrust_schedule: BoostCoast)),
    allowed_components: [Category(Sensors), Category(Utility)],
    carrier: true,
    availability: CivilianOnly,
    ntds_classification: Explicit(CommandShip),
    target_domains: [],
    guidance_uplink: None,
    battery_capacity_kwh: 60.0,
    base_power_draw_kw: 8.0,
    power_supply_kw: 150.0,
    engine_bells: (loiter: Some(0.18), cruise: Some(0.6), full: Some(0.84)),
)
