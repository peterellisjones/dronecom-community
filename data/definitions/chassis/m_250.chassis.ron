// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "m_250",
    designator: "M-250",
    codename: "Claymore",
    domain: Air,
    automatic_evasion_policy: Off,
    launch_requires: [VLS, AirLaunch],
    recovery_requires: [],
    provides: [],
    length: 3.5,
    // AIM-120C-5-class structure derived from its 161.5 kg official gross mass
    // after the provisional propellant and class-warhead estimates below.
    weight: 80.1,
    // Ceiling: 97 kg of seeker and warhead on a full tank, so a MK-120 mounts
    // at a performance cost. The stock M-250A carries 30.1 kg of that and
    // flies at the AIM-120C-5-class 161.5 kg gross mass.
    max_weight: 228.4,
    // Provisional C-5 solid-propellant estimate.
    max_fuel: 51.3,
    hit_points: 10.0,
    // Estimated: half the ~0.2 m missile body diameter (#5193).
    full_damage_radius_m: 0.1,
    drag: 0.025,
    mast_height: 0.0,
    em_signatures: Some((rcs: 0.05, ir_base: 15.0, visual_cross_section: 0.15)),
    acoustic_signatures: None,
    physics: FixedWing(
        min_altitude: 50.0,
        max_altitude: 15000.0,
        default_altitude: 100.0,
        min_attack_altitude: Some(0.0),
        max_attack_altitude: None,
        launch_speed: Some(300.0),
        max_pitch_rate: 1.05,
        max_yaw_rate: 0.52,
        stall_speed: 60.0,
        max_lateral_g: 50.0,
        supported_trajectories: [Direct, Lofted],
        terrain_clearance: 20.0,
    ),
    // Provisional C-5-class estimate: 51.3 kg at 384.4 kg/min powers this
    // 16.7 kN BoostCoast phase for 8.0 s (approximately 265.7 s effective Isp).
    engine: Powered((thrust_n: 16_700.0, fuel_burn_rate: 384.4, idle_burn_fraction: 1.0, thrust_response: Constant, thrust_schedule: BoostCoast, signature: Rocket)),
    allowed_components: [Category(Sensors), Category(Warheads), Category(Utility)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: Explicit(Missile),
    target_domains: [Air, SeaSurface, Land],
    guidance_uplink: FromLauncher,
    // After burnout, the battery powers the seeker and electronics.
    // The shipped Radar Missile must cover its fitted max-reach flight from
    // the MQ-450's 8 km launch ceiling with a 1.5x coast-endurance margin.
    // Guarded by `dc_autopilot::radar_missile_battery_outlasts_best_range_loft`.
    battery_capacity_kwh: 0.32,
    base_power_draw_kw: 0.5,
    power_supply_kw: 1.1,
    engine_bells: (loiter: None, cruise: None, full: None),
)
