// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "m_100",
    designator: "M-100",
    codename: "Stiletto",
    domain: Air,
    automatic_evasion_policy: Off,
    launch_requires: [VLS, AirLaunch],
    recovery_requires: [],
    provides: [],
    length: 2.5,
    // AIM-9M-class structure derived from its 85.5 kg official gross mass after
    // the provisional propellant and class-warhead estimates below.
    weight: 40.9,
    // Ceiling: 28.8 kg of seeker and warhead on a full tank, so a MK-40 mounts
    // at a performance cost. The stock M-100A carries 17.4 kg of that and
    // flies at the AIM-9M-class 85.5 kg gross mass.
    max_weight: 96.9,
    // Provisional Mk-36-class solid-propellant estimate.
    max_fuel: 27.2,
    hit_points: 5.0,
    // Estimated: half the ~0.13 m missile body diameter (#5193).
    full_damage_radius_m: 0.07,
    // Slender high-speed dart geometry.
    drag: 0.014,
    mast_height: 0.0,
    em_signatures: Some((rcs: 0.01, ir_base: 10.0, visual_cross_section: 0.1)),
    acoustic_signatures: None,
    physics: FixedWing(
        min_altitude: 50.0,
        max_altitude: 10000.0,
        default_altitude: 100.0,
        min_attack_altitude: Some(0.0),
        max_attack_altitude: None,
        launch_speed: Some(250.0),
        max_pitch_rate: 1.40,
        max_yaw_rate: 1.00,
        stall_speed: 80.0,
        max_lateral_g: 60.0,
        supported_trajectories: [Direct, TerrainFollow, Lofted],
        terrain_clearance: 15.0,
    ),
    // Provisional Mk-36-class estimate: 27.2 kg at 544 kg/min powers this
    // 23.1 kN BoostCoast phase for 3.0 s (approximately 260 s effective Isp).
    engine: Powered((thrust_n: 23_100.0, fuel_burn_rate: 544.0, idle_burn_fraction: 1.0, thrust_response: Constant, thrust_schedule: BoostCoast, signature: Rocket)),
    allowed_components: [Category(Sensors), Category(Warheads), Category(Utility)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: Explicit(Missile),
    target_domains: [Air, SeaSurface, Land],
    guidance_uplink: FromLauncher,
    // Governed by the M-100 best-range-flight reserve guard.
    battery_capacity_kwh: 0.13,
    base_power_draw_kw: 0.5,
    power_supply_kw: 1.0,
    engine_bells: (loiter: None, cruise: None, full: None),
)
