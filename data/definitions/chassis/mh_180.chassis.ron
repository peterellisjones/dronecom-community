// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "mh_180",
    designator: "MH-180",
    codename: "Hornet",
    domain: Air,
    automatic_evasion_policy: On,
    // Helipad first: #4629 made it its own station, and first-match is what the
    // display tag, the munition-transfer station, and recovery routing all use.
    // A helo spots, rearms and lands on the pad; the flight deck is the fallback
    // for a hull that has no pad (the CV-1000) and, at launch, for a pad that is
    // already busy.
    launch_requires: [HeliPad, FlightDeck],
    recovery_requires: [HeliPad, FlightDeck],
    provides: [(facility: AirLaunch, cells: 4, max_simultaneous_launches: 4)],
    length: 8.0,
    weight: 550.0,
    max_weight: 1300.0,
    max_fuel: 200.0,
    hit_points: 40.0,
    drag: 5.70,
    mast_height: 0.0,
    em_signatures: Some((rcs: 0.5, ir_base: 6.0, visual_cross_section: 0.6)),
    acoustic_signatures: None,
    physics: RotaryWing(
        // Must stay above sea level (#3436): the waterline is terminal for an air
        // vehicle, and this value is a *commandable* floor — it bounds
        // SetCommandedAltitude, is the fallback attack floor, and is the altitude
        // flown when the recovery carrier is lost. At the previous 0.0 the
        // helicopter was authorised onto the surface and duly sat there (68
        // separate idle-loiter touches across the scenario suite). 10 m matches
        // both `RotaryWingModel::default()` and the flight-deck height.
        min_altitude: 10.0,
        max_altitude: 4000.0,
        default_altitude: 200.0,
        max_pitch_rate: 0.44,
        max_yaw_rate: 0.35,
        // Vertical (rotor-axis) drag area, ~9x the horizontal `drag: 5.70`. A
        // helicopter climbing/descending fights its rotor disc + downwash, not
        // its fuselage cross-section, so vertical motion is far more drag-limited
        // than forward flight. Tuned to a realistic ~14 m/s climb at loaded
        // weight (the single horizontal drag_area gave ~42.5; #2087).
        vertical_drag_area: 52.0,
    ),
    propulsion: Rotary,
    // AirDensity (#2103): rotor thrust lapses with air density (T ∝ ρ), so climb
    // degrades with altitude toward an emergent hover ceiling (the fixed-collective
    // rotor model, ADR-0011). Identical to Constant at/near sea level.
    engine: Powered((thrust_n: 18800.0, fuel_burn_rate: 7.0, idle_burn_fraction: 0.10, thrust_response: AirDensity, thrust_schedule: BoostCoast)),
    allowed_components: [Category(Sensors), Category(Warheads), Category(Utility), Category(CarriedEntities)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: DeriveFromDomain,
    // What an ARMED MH-180 can ram. Unarmed builds claim none of these (the
    // seeding in blueprint stats is warhead-conditional). `RotaryWing` declares
    // no attack-altitude override, so the ram runs in at the deliberate 10 m
    // floor above (#3436) rather than at the surface — inside every warhead's
    // 20–30 m proximity-fuze radius, so it still fuzes. Must not name
    // `Submarine` — an air hull cannot reach a submerged target.
    target_domains: [Air, SeaSurface, Land],
    guidance_uplink: None,
    battery_capacity_kwh: 1.0,
    base_power_draw_kw: 1.0,
    power_supply_kw: 10.0,
    engine_bells: (loiter: Some(0.195), cruise: Some(0.65), full: Some(0.86)),
)
