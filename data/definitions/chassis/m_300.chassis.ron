// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/chassis.md
(
    id: "m_300",
    designator: "M-300",
    codename: "Sabre",
    domain: Air,
    automatic_evasion_policy: Off,
    launch_requires: [VLS, AirLaunch],
    recovery_requires: [],
    provides: [],
    length: 4.17,
    // Derived HARM/AARGM-class mass-closure remainder (#5353): 361 kg gross
    // less 156.5 kg propellant, 12 kg seeker, and 66 kg warhead.
    weight: 126.5,
    // Ceiling: 137.5 kg of seeker and warhead on a full tank. The stock M-300A
    // carries 78 kg of that and flies at the HARM/AARGM-class 361 kg gross mass.
    max_weight: 420.5,
    max_fuel: 156.5,
    hit_points: 10.0,
    // Estimated: half the ~0.25 m missile body diameter (#5193).
    full_damage_radius_m: 0.13,
    drag: 0.025,
    mast_height: 0.0,
    em_signatures: Some((rcs: 0.05, ir_base: 15.0, visual_cross_section: 0.15)),
    acoustic_signatures: None,
    physics: FixedWing(
        min_altitude: 50.0,
        max_altitude: 15000.0,
        default_altitude: 100.0,
        min_attack_altitude: Some(0.0),
        max_attack_altitude: None,
        launch_speed: Some(300.0),
        max_pitch_rate: 1.05,
        max_yaw_rate: 0.52,
        stall_speed: 60.0,
        max_lateral_g: 50.0,
        supported_trajectories: [Direct, Lofted],
        terrain_clearance: 20.0,
    ),
    // Provisional HARM/AARGM-class dual-thrust solid motor (#5353). The public
    // class anchor establishes gross mass and length; this motor is an explicit
    // estimate: 30 kN at 705.9 kg/min burns 70.59 kg in 6 s, then 14.6 kN
    // (48.67%) at 343.6 kg/min burns approximately 85.9 kg in 15 s. The
    // 156.5 kg tank supplies approximately 399 kN-s at approximately 260 s.
    engine: Powered((thrust_n: 30000.0, fuel_burn_rate: 705.9, idle_burn_fraction: 1.0, thrust_response: Constant, thrust_schedule: BoostSustain(boost_fuel_kg: 70.59, sustain_thrust_fraction: 0.4867, sustain_burn_rate: 343.6), signature: Rocket)),
    allowed_components: [Category(Sensors), Category(Warheads), Category(Utility)],
    carrier: false,
    availability: PlayerAvailable,
    ntds_classification: Explicit(Missile),
    target_domains: [Air, SeaSurface, Land],
    guidance_uplink: FromLauncher,
    // Coast reserve sized to outlast the best-possible-range flight (#2524, same
    // rule as the M-250 #2247 / M-100 #2251 guards). Verified by the per-codename
    // `munition_battery_reserve` guard (`arm_battery_outlasts_best_range_flight`),
    // which re-derives the requirement from the live flight model — a reach retune
    // that lengthens the coast re-fails it until this is resized.
    battery_capacity_kwh: 0.5,
    base_power_draw_kw: 0.5,
    power_supply_kw: 0.8,
    engine_bells: (loiter: None, cruise: None, full: None),
)
