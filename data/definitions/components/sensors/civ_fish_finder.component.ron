// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/components.md
(
    id: "civ_fish_finder",
    designator: "FF-100",
    codename: "Trawlfinder",
    category: Sensors,
    mount_rule: Single,
    weight: 15.0,
    power_draw: Derived,
    // #3704: `an_sqs_40`'s active half IS a `Domain(Sea)` search sonar already
    // in the registry, but it's the wrong set for a trawler: a $3.4M-class
    // military ASW localizer (8 tracks, lock-detection audible fleet-wide) —
    // mechanically and thematically a bad fit for commercial fishing gear, and
    // reusing it would give a civilian contact a *military* emitter
    // fingerprint. This is a new, civilian-grade entry instead (modeled on
    // `an_sqs_40`'s active half's physics/characteristics shape, but shorter
    // reach, quieter ping, no lock capability), so the emitter channel
    // fingerprints this hull as what it is.
    //
    // Confined to the Factory Trawler by chassis id, not domain (#3704 code
    // review): a bare `Domain(Sea)` filter would put this active-sonar
    // Search set — 15 kg, ~$115K, no lock capability — in the designer
    // catalog for every player-buildable Sea chassis, ~30x cheaper than
    // `an_sqs_40`. `ChassisFilter::Chassis` confines it to the one hull it's
    // meant for; since that chassis is `CivilianOnly` (#3703), the component
    // is unreachable from any player-facing surface.
    allowed: [Chassis("autonomous_factory_trawler")],
    payload: Sensor([(
        kind: SonarActive,
        capability: Search( tracks: Limited(4), lock_detection: false ),
        threshold: 0.00000001,
        scan_interval: 4.0,
        acquire_dwell_secs: 1.0,
        bearing_rate_tau_secs: 2.0,
        is_active: true,
        emits: Some(SonarPassive),
        emission_strength: 50000000000000000000.0,
        fov_h: 360.0,
        fov_v: 180.0,
        mounting: Hull,
        iff_threshold: 0.0000005,
        spreading_exponent: 1.2,
        characteristics: SonarActive(
            v_notch: 3.0,
            notch_fraction: 0.3,
        ),
        physics: ActiveSonar(bandwidth_hz: 20.0, frequency_hz: 5000.0, array_length_m: 0.6, sound_speed_mps: 1500.0),
        authored_noise: (velocity_sigma_mps: 6.0, altitude_sigma_m: 100.0, fdoa_sigma_mps: 30.0),
        signature_capability: None,
        elevation: Resolves,
        fdoa: None,
    )]),
)
