// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/components.md
(
    id: "an_apg_17",
    designator: "AN/APG-17",
    codename: "Pointer",
    category: Sensors,
    mount_rule: Single,
    weight: 12.0,
    power_draw: Derived,
    allowed: [Domain(Air)],
    payload: Sensor([(
        kind: Radar,
        // Anti-ship seeker (#5498): the AN/APG-15's airframe and fire-control
        // lock, plus a wide-band surface-search waveform, so a stopped or
        // crossing ship is held by its echo rather than notched out with the
        // sea. The AN/APG-15 stays the anti-air seeker.
        capability: Track( locks: (1) ),
        threshold: 0.00000000000000001,
        scan_interval: 0.5,
        acquire_dwell_secs: 1.0,
        bearing_rate_tau_secs: 2.0,
        is_active: true,
        emits: Some(Rwr),
        emission_strength: 50000000.0,
        fov_h: 60.0,
        fov_v: 60.0,
        mounting: MastBoth,
        iff_threshold: 0.0,
        spreading_exponent: 2.0,
        characteristics: Radar(surface_search: Capable(bandwidth_hz: 100000000.0)),
        physics: ActiveRadar(bandwidth_hz: 1000000.0, carrier_freq_hz: 35000000000.0, aperture_m: 0.20),
        authored_noise: (velocity_sigma_mps: 3.0, altitude_sigma_m: 60.0, fdoa_sigma_mps: 30.0),
        signature_capability: Capable(min_snr_db: 12.0),
        elevation: Resolves,
        fdoa: None,
    )]),
)
