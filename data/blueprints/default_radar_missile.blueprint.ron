// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/blueprints.md
(
    id: BlueprintId("00000000-0000-0000-0000-000000000003"),
    codename: "Radar Missile",
    designator: "M-250A",
    chassis_id: "m_250",
    fuel_tank_percent: 1.0,
    inventory: [
        // Active radar seeker
        (kind: Component(component_id: "an_apg_17")),
        // Warhead
        (kind: Component(component_id: "mk_120")),
    ],
    doctrine_setting: Suggested,
    // Boost-sustain BVR loft (#2185): the M-250 lofts so the sustain motor's
    // energy buys long reach. The mandated terminal dive angle (#5196) applies
    // uniformly regardless of range, so a short shot pays the same steep-dive
    // cost as a genuine BVR one — reach at close range is traded for the
    // authored impact angle, not preserved by a range-adaptive shallow cruise.
    trajectory: Lofted,
    default_altitude: Chassis,
    unknown_range_launch: Withhold,
    stores: [],
)
