// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/trajectory.md
// Missile trajectory controller tuning — terminal impact-angle guidance,
// post-burnout glide, terrain-follow hold, terrain commitment. Consumed by
// dc_autopilot::trajectory (#5196).
TrajectoryConfig(
    cruise_reached_tolerance: 150.0,
    // Standing terrain/presentation safety-commitment slant (#3409/#3449),
    // not a loft/reach handoff — no impact-law switch depends on it.
    terrain_commitment_range: 4000.0,
    glide_descent_rad: 0.209, // ≈ 12° below horizon (~4.7:1 glide)
    // Impact-angle guidance (#5196): a Lofted round's terminal-elevation bias
    // steers toward this angle continuously from launch, replacing the
    // former geometric loft cruise/FOV-height cap.
    lofted_impact_angle_rad: -1.04719755, // -pi/3, 60° below horizon
    lofted_impact_tolerance_rad: 0.0872664626, // 5°
    // A TerrainFollow round's shallow skim-angle terminal objective.
    skim_impact_angle_rad: -0.0872664626, // 5° below horizon
    skim_impact_tolerance_rad: 0.0523598776, // 3°
    impact_angle_gain_per_s: 0.30,
)
