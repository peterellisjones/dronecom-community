// Field reference: https://github.com/peterellisjones/dronecom-community/blob/main/data/docs/simulation.md
// Simulation configuration — autopilot, deck ops, sensors, tasking, sectors.
SimConfig(
    autopilot: (
        waypoint_threshold: 5.0,
        sea_terrain_clearance: 5.0,
        air_terrain_clearance: 100.0,
        submarine_terrain_clearance: 10.0,
        submarine_surface_clearance: 5.0,
        // #4680: vertical room a submarine keeps under its own no-broach
        // ceiling at a REST point, beyond the terrain-clearance gap already in
        // its navigability threshold. Measured against raw seabed relief, not
        // the navigation view, which deepens all water to the shared floor.
        // Zero disables the rule rather than tightening nothing.
        submarine_station_clearance_m: 10.0,
        edge_projection_min_size: 400.0,
        submarine_max_depth_change_m: 50.0,
        air_climb_rate_fraction: 0.3,
        terrain_avoidance: (
            look_ahead_seconds: 3.0,
            avoidance_angles: [10.0, 20.0, 30.0, 40.0, 50.0, 70.0, 90.0, 120.0, 150.0, 180.0],
            // Must stay well above the shipped Sea fleet's 25 m full-speed turn
            // radius or this clips a hull we ship (#4179).
            turn_circle_cap_m: 200.0,
        ),
        group_target_lookahead_secs: 0.1,
        formation_reform_gain: 0.5,
        formation_reform_enter_m: 300.0,
        formation_reform_exit_m: 80.0,
        formation_catchup_headroom_frac: 0.15,
        formation_headroom_ramp_per_sec: 0.5,
        formation_reform_converge_min_mps: 2.0,
        terminal_homing: (
            gate_range_steps: 4.0,
            // dt-independent terminal-endgame time-to-go (s) at the mover's MAX
            // speed, a floor on the range gate shared by the homing-entry and
            // #2290 spend gates (#2373). A lofted missile coasts to a low terminal
            // speed, collapsing the current-speed `speed·dt·gate_range_steps` to
            // ~the fuze radius; keying the floor to max_speed keeps a fast
            // missile's terminal envelope wide (M-250 ~266 m, catches its miss)
            // while a slow torpedo's stays below its fuze radius (~6-8 m, so its
            // spend gate is subsumed by the fuze and its behaviour is unchanged).
            terminal_gate_secs: 0.3,
            max_substep_secs: 0.05,
            off_nose_full_speed_rad: 0.3,
            off_nose_min_speed_rad: 1.2,
            turn_speed_frac: 0.1,
            los_lead_secs: 0.4,
            // #2649 loiter guard. A round that reaches its target but settles
            // into a constant-range circle neither fuzes nor recedes, so
            // nothing ended it: 3 s inside its own blast radius without
            // improving its closest approach by 5 m spends it.
            loiter_spend_secs: 3.0,
            loiter_progress_m: 5.0,
        ),
        patrol_loop: (
            sample_spacing_m: 100.0,
            min_samples: 16,
            max_samples: 256,
            follow_lookahead_m: 150.0,
            follow_entry_threshold_m: 75.0,
            // Above this arc→bridge turn angle the shortest bridge is a hairpin;
            // re-route the bridge the sweep-continuous way around the obstacle.
            bridge_reversal_threshold_deg: 90.0,
            // Lateral clearance kept between the loop and impassable terrain.
            bridge_clearance_margin_m: 250.0,
            // #2609: inward margin off the circular playable boundary for a
            // ring-clamping domain (fixed-wing). A rim-crossing orbit ring is
            // patrolled as the in-circle arc, held this far inside the rim so the
            // flown arc + corner rounding never grazes the boundary.
            rim_inset_m: 100.0,
            // Absolute distance (m) a moving anchor (Screen/FormingUp) must drift
            // before re-issuing the orbit — keeps the routing cache + plan-failed
            // warn throttle alive instead of churning every tick. Kept under the
            // escort station-keeping tolerance so a large-radius screen still
            // tracks its protected entity closely.
            recenter_hysteresis_m: 30.0,
            // #2548: horizontal speed (m/s) below which a Screen leader treats
            // its protectee as stationary and station-keeps (surface units only;
            // a fixed-wing always orbits). Gates only orbit -> station-keep; the
            // reverse is position-based on recenter_hysteresis_m.
            station_keep_speed_mps: 2.0,
        ),
        // #4705: how far ahead the anti-beaching guard tests the line it is
        // given. Every terminal controller hands it a BEARING it re-derives each
        // tick — a 1 km constant (formation), a ring radius (orbit), the
        // standoff range — not a destination, so testing the whole line stops
        // hulls that were never in danger. The distance a hull is actually
        // committed to is its own v^2/2a.
        anti_beach: (
            // Must be > 1: at exactly 1 this test becomes the guard's own
            // stopping-track test and the Hold/StopToward distinction collapses.
            //
            // Near-inert on today's content, and worth knowing before tuning it:
            // every shipped naval hull stops in 18-66 m at top speed, so x2 is
            // 35-132 m and the 100 m floor below decides for all of them but the
            // USV-80 near its own top speed. #4705's formation acceptance sweep
            // measures k = 1, 1.5 and 2 identically for that reason. #4809
            // confirmed raising it stays inert: the guardian's binding moment is
            // near-stationary station-keeping, where the horizon is floor_m
            // regardless of the factor, and no floor_m below shipped survived
            // that guardian either (see below).
            stopping_distance_factor: 2.0,
            // A stopped hull has zero stopping distance; without this floor the
            // segment degenerates to a point and the guard can never refuse a
            // hull that is about to get way on toward a beach.
            //
            // Pure conservatism since #4813, unlike the terrain quadtree's
            // min_cell_size bound it once had to sit above. #4809 measured a
            // retune against the census and the
            // #4664 clearance guardian (formation_follower_does_not_steer_its_
            // leaders_course_ashore):
            //
            //   floor_m | census arrests | census false pos | #4664 closest | gate
            //     50    |     4380       |      2774         |   658.6 m    | FAIL
            //     60    |     4416       |      2810         |   658.6 m    | FAIL
            //     66    |     4488       |      2882         |   668.8 m    | FAIL
            //     75    |     4536       |      2930         |   668.8 m    | FAIL
            //     80    |     4536       |      2930         |   668.8 m    | FAIL
            //     90    |     4584       |      2978         |   677.3 m    | PASS
            //    100 ship|     4584       |      2978         |   687.8 m    | PASS
            //
            // What a lower floor buys and costs move together and cross the
            // wrong way: every value that cuts census cost below shipped (50-80)
            // fails the 670 m gate, and the one value short of 100 that clears it
            // (90) matches shipped exactly on census cost while giving up 10.5 m
            // of margin for nothing. No floor_m in this bracket both saves cost
            // and keeps the guardian green, so 100 m is not a min_cell_size
            // carry-over — it is independently close to the efficient point.
            // Full table and re-verification note in AntiBeachSection::floor_m's
            // doc (dc_types/src/sim_config.rs).
            floor_m: 100.0,
            // How WIDE the guard looks, as against how far: the clearance it
            // keeps off a coast it is steering along, on the bearing arm only
            // (#4813).
            //
            // It is not new behaviour, only newly stated. The old cell-bound
            // line test read land within `half_size*sqrt(2)` of any coast, and at
            // a one-cell horizon that over-reach WAS the guard's standoff —
            // #4735 measured the #4664 follower closing from 687 m to 644.3 m of
            // a 600 m island (670 m gate) when it was removed. Stated here it is
            // uniform rather than dependent on where a cell corner falls.
            //
            // 44 m is the knee of both instruments at once, which is why it is
            // this and not the ~43 m #4813 back-solved from one trajectory:
            //
            //   standoff | #4664 clearance | census arrests | false pos
            //     40 m   |     664.0 m     |     4424       |   2818
            //     42 m   |     677.3 m     |     4520       |   2914
            //     44 m   |     687.8 m     |     4584       |   2978
            //     48 m   |     687.8 m     |     4600       |   2994
            //     50 m   |     687.8 m     |     6250       |   4632
            //
            // Clearance saturates at 44 m (the 670 m gate is cleared at 42, the
            // historic 687 m only at 44) and the census cost is flat from 44 to
            // 48 before jumping 36% at 50 — so 44 buys the whole clearance at the
            // bottom of the flat, with 6 m of guard band before the cliff.
            // Station-keeping is 330-334 ticks across the entire sweep and never
            // approaches its 325 floor, so it does not constrain this value.
            //
            // Raising it past 48 falls off that cliff. Lowering it gives up
            // clearance fast: 30 m measures 654 m and 20 m measures 652 m, both
            // under the gate, against 639 m for no guard at all.
            //
            // Do not read this as under-keel clearance: that is
            // `sea_terrain_clearance` / `submarine_terrain_clearance`, and it is
            // in the envelope the guard shares with the planner. This is lateral
            // room, in metres of water beside the hull.
            coastal_standoff_m: 44.0,
        ),
        // #2352: bound lead-pursuit heading jitter from noisy target-velocity
        // estimates. A weapon aims at contact_pos + contact_vel·t; velocity
        // estimate noise σ_v swings the heading by ~σ_v/V_closing. The lead
        // velocity is scaled by min(1, this·weapon_speed/σ_v) so the jitter is
        // capped here (~1.4°). σ_v=0 (exact sensing) ⇒ full lead (unchanged).
        // Fast missiles keep full lead (σ_v small vs this·V); only slow weapons
        // (torpedoes) — where the same noise fishtails the heading — damp.
        lead_velocity_noise_tolerance_rad: 0.025,
        // #2520: grace period before a spent munition (fuel dry → on battery)
        // may scuttle, so an out-of-fuel torpedo doesn't sit dead-in-the-water
        // pinging its seeker for ~an hour of hotel battery. Only projectiles
        // scuttle on this; platforms keep their full battery.
        //
        // #3378: this is NOT sized above a legitimate terminal coast — it used
        // to claim it was, while the M-250 glides 83 s to its own credited max
        // reach and was deleted mid-flight for it. Raising it is not how a
        // coasting round is protected; `munition_derelict_speed_mps` below is.
        // Keep it well short of any credited flight so a genuinely dead round
        // still goes away promptly.
        munition_battery_scuttle_secs: 45.0,
        // #3378: at or below this speed a spent munition past the grace period
        // above is derelict — dead in the water — and scuttles. A spent torpedo
        // is driven to a hard stop by the submarine model itself (battery mode
        // commands zero speed), so it settles at 0.0 and trips this; a spent
        // missile glides on at flight speed, two orders of magnitude clear, so it
        // is never near this. 1 m/s ≈ 2 kt: no hull under way is this slow.
        munition_derelict_speed_mps: 1.0,
        // #2515: how far past the quadtree extent (`half_extent`, ~51.2 km on the
        // 50 km production map) a projectile may stray before it is scuttled.
        // `half_extent` is the exact boundary past which `find_path` can't route a
        // round back — beyond it, it mills as an out-of-bounds zombie. Keyed on
        // `half_extent` (not `radius`) so a legitimate engagement in the
        // radius..half_extent ring keeps headroom. 5 km catches the pathological
        // 59–67 km playtest excursions while leaving rim engagements untouched.
        munition_out_of_bounds_scuttle_margin_m: 5000.0,
        evade_weave_amplitude_rad: 0.6,
        evade_weave_period_secs: 8.0,
        evade_weave_look_ahead_m: 1200.0,
    ),
    launch: (
        launch_altitude_offset: 10.0,
        launch_clearance_distance: 500.0,
        well_deck_reverse_speed: 3.0,
        default_loiter_altitude_fixed_wing: 300.0,
        default_loiter_altitude_rotary_wing: 50.0,
        air_launch_drop_distance: 5.0,
        holding_pattern_length: 1500.0,
        // Width sized so the racetrack's semicircular ends (radius = width/2)
        // accommodate the widest turn radius among fixed-wing airframes. The
        // worst case is the MQ-450 (stall 50 m/s, yaw 0.17 rad/s → turn radius
        // 50/0.17 ≈ 294 m at min speed); 650 m gives a 325 m semicircle radius
        // (~10% headroom) so every airframe can physically fly the pattern.
        holding_pattern_width: 650.0,
        holding_pattern_altitude: 300.0,
        holding_pattern_entry_threshold: 200.0,
        // Corner-rounding lookahead, kept equal to width/2 (the semicircle radius).
        holding_pattern_turn_radius: 325.0,
        holding_pattern_speed_multiplier: 1.5,
        landing_arrival_threshold: 50.0,
        landing_final_approach_lookahead: 400.0,
        landing_capture_cross_half_width: 70.0,
        landing_capture_along_half_length: 200.0,
        well_deck_recovery_follow_distance: 300.0,
        well_deck_arrival_threshold: 50.0,
        // #4654: how close a hull must be before it may claim the well deck's
        // single approach slot. The airspace is Serial (cap 1) and is released
        // only by capture, so the holder blocks every recovery behind it; before
        // this gate the slot was claimed the instant the transit LOS test
        // cleared, which on open water is the tick the order is issued, at any
        // range. Measured: a hull ordered home from 6 km delayed a hull 200 m
        // off the carrier from 15.8 s to 249 s.
        //
        // 400 m is the smallest figure that still clears the 300 m follow
        // station with usable margin (a hull converging on that station must be
        // admitted, and rendezvous_steer approaches it asymptotically). It is
        // bounded below by that geometry, not chosen for the timing.
        well_deck_approach_admission_range_m: 400.0,
        // #4654: how much closer the craft holding the approach slot must get
        // for the #3891 stall clock to re-arm. The bound measures FAILURE TO
        // CLOSE, not elapsed time — a time bound cannot work, because the
        // legitimate hold is set by net closure (hull speed minus carrier
        // speed), which tends to zero as a carrier's cruise approaches its own
        // craft's. Measured on the shipped `welldeck_moving_carrier` fixture: an
        // Attack Submarine recovering onto a carrier under way legitimately
        // holds the slot 190.5 s at ~1.5 m/s net closure, and latched the stall
        // warning at 66.5 s while doing nothing wrong.
        //
        // 25 m is large enough that position noise and a carrier's own weave
        // cannot re-arm the clock, and small enough that even that 1.5 m/s
        // closure re-arms it roughly every 17 s against the 66 s bound. A craft
        // that has stopped — the #4594 hold-station case this yields on — makes
        // no progress at all and so still trips promptly.
        well_deck_approach_progress_epsilon_m: 25.0,
        // Well clear of well_deck_arrival_threshold (50 m) so a holding hull
        // never reads as "docked"; well inside well_deck_recovery_follow_distance
        // (300 m) so the queue stays visually tight astern of the carrier (#2627).
        // Sized down from an initial 150 m: a queued hull must close this whole
        // distance when promoted to rank 0, and 150 m measurably slowed the
        // 3-drone acceptance scenario (~217 vs ~174 ticks baseline); 100 m keeps
        // that close-in cost small (~184 ticks) while staying 2x the arrival
        // threshold.
        well_deck_holding_station_spacing_m: 100.0,
        rally_radius_m: 120.0,
        deck_phases: (
            // Must stay near 1 s total: the carrier first sees an inbound
            // M-250 at ~11 km (~12 s out), and a slower response leaves no
            // room for an interceptor to fly out past its own dead zone
            // (#3380, #3381).
            vls: (arming: 0.5, launch: 0.5),
            air_launch: (arming: 0.5, release: 0.5),
            torpedo_tube: (flooding: 5.0, launch: 2.0),
            flight_deck: (hangar: 15.0, elevator: 10.0, deck: 8.0, catapult: 5.0),
            // #4629: the flight deck's cycle without the catapult — a helo is
            // spotted and lifts under its own rotor. The three shared numbers
            // are deliberately identical to flight_deck's: the split gave a
            // hull authoring both facilities a second lane, and that is meant
            // to be the only thing it changed.
            heli_pad: (hangar: 15.0, elevator: 10.0, pad: 8.0),
            well_deck: (staging: 12.0, well_deck: 10.0),
        ),
    ),
    debug_spawn: (
        air_default_altitude: 500.0,
        air_terrain_clearance: 100.0,
        sub_default_depth: -50.0,
        sub_terrain_clearance: 10.0,
    ),
    sensors: (
        // #2375: a Lost contact is purged once EITHER bound below is crossed
        // (whichever comes first) — except while AwaitingBda, which is
        // protected until its BDA deadline resolves (#2402).
        // max_position_sigma_m is normally the bound that fires; max_age_secs
        // is a backstop for contacts whose position fix never resolves
        // numerically. Since #3879 made filter.process_noise below per class,
        // time-to-purge is per class too: ~100 s for an aircraft, ~127 s for a
        // ship, ~326 s for a submarine.
        //
        // max_position_sigma_m is calibrated to hold that retention band, NOT
        // to any geometric bound such as the world radius (#4941). A
        // dead-reckoned position σ grows as √(q·dt³/3) for q = σ_a²·τ, so purge
        // time scales as σ_a^(−2/3): the spread across classes is wider than
        // the σ_a ratios alone suggest, and the submarine case is the one that
        // runs long enough for max_age_secs to matter. 5774 is the σ that puts
        // an aircraft at 100 s — the class the band is anchored on, because it
        // is the one whose stale tracks crowd a capacity-limited picture.
        // Retune this against the band above, not against the map.
        stale_retention: (
            max_age_secs: 600.0,
            max_position_sigma_m: 5774.0,
            recheck_interval_secs: 15.0,
        ),
        contact_capacity_hysteresis: 0.10,
        // DC-36.1 recursive track filter (used only when noisy sensing is on).
        filter: (
            // #3879: per-class horizontal process noise, replacing one global
            // 2.0 that served a cargo ship and an IR missile alike. Derived from
            // the shipped chassis — a_max = min(max_lateral_g·9.81, max_speed ×
            // turn_rate), maxed over the class, then σ_a = a_max/√3 (uniform
            // manoeuvre). The three fastest entries are held at a CEILING of
            // 10.0, which is what keeps a tracked target's course and speed
            // readable between scans: the AI stops leading its shots once the
            // read-time velocity gate reads Unresolved.
            //
            // The gate is not what binds at 10.0. Coasted
            // velocity variance is q·dt = σ_a²·τ·dt, so staying inside
            // velocity_resolved_var_threshold across the slowest air-search
            // revisit allows σ_a up to √(1600/(τ·4)) = 20 at the τ below. The
            // ceiling is the more conservative of the two and is what actually
            // caps modelled agility — a real missile's 340 m/s² is 34x it.
            // Whether to spend that headroom is a balance question, separate
            // from making the gate fractional rather than an absolute 40 m/s σ
            // (#4927).
            process_noise: (
                // ss_400: 8.6 m/s × 0.343 rad/s = 3.0 m/s².
                subsurface_mps2: 1.7,
                // usv_80: 17.5 m/s × 0.699 rad/s = 12.2 m/s². Also carries Land
                // (a static target is no more agile than a ship).
                surface_mps2: 7.0,
                // mk_55: 28.0 × 1.118 = 31.3 m/s² → 18.1, at the ceiling.
                torpedo_mps2: 10.0,
                // mq_160: 230.5 × 0.300 = 69.2 m/s² → 40.0, at the ceiling.
                air_mps2: 10.0,
                // m_100: structural 60 g = 588.6 m/s² → 340.0, at the ceiling.
                missile_mps2: 10.0,
                // Must stay >= every entry above: an unclassified contact could
                // be any of them, and lag costs more than a covariance floor.
                unknown_mps2: 10.0,
            ),
            // #4941: manoeuvre correlation time τ (s) — how long a target holds
            // an acceleration of scale σ_a before drawing a new one. With the
            // table above it gives the process-noise power spectral density
            // q = σ_a²·τ, and the filter's Q is the continuous
            // white-noise-acceleration form q·[dt³/3, dt²/2; dt²/2, dt].
            //
            // τ has to be stated rather than left implicit: the discrete
            // alternative takes the propagation step to BE the correlation
            // time, which makes a track's uncertainty growth follow sensor
            // revisit cadence (0.03 s to 5 s across the shipped sensors)
            // instead of elapsed time, and makes splitting one coast into
            // substeps change the answer.
            //
            // 1.0. τ sets the interval at which this form matches the
            // displacement of a sustained σ_a manoeuvre; below it the model
            // overstates position error, above it understates. One second sits
            // at the short end deliberately, because the tightest consumer of
            // position σ is fire-control acquisition, which gates a beamwidth
            // footprint against a sub-second coast: at τ = 4 a 0.5 s coast
            // carries 11.7 m of σ against a 0.5°-at-900 m gate of 7.9 m, and a
            // 2 Hz fire-control set watching a 1 Hz search track drops its
            // acquire dwell on alternate scans.
            //
            // The price is paid at the long end, where this τ understates: a
            // track's velocity stays Resolved across 1600/(σ_a²·τ) seconds of
            // coasting — 16 s for an aircraft, 32.7 s for a ship, 553.6 s for a
            // submarine — so a unit keeps leading its shots deep into a gap in
            // coverage.
            process_noise_correlation_time_secs: 1.0,
            // #2151: vertical maneuvering is gentler than horizontal, so keep this
            // BELOW the horizontal entries. A high value over-couples PY<->VY, so
            // noisy long-range altitude observations leak into a large spurious
            // vertical velocity (was 4.0 → up to ±21 m/s on a stationary contact;
            // 1.0 caps it near ~8 m/s while altitude resolution stays smooth).
            // subsurface_mps2 (1.7) is the lowest horizontal entry, so the
            // ordering holds across the whole table.
            vertical_process_noise_accel_mps2: 1.0,
            initial_position_var: 10000.0,
            initial_velocity_var: 2500.0,
            initial_altitude_var: 100000000.0,
            initial_vertical_velocity_var: 2500.0,
            elevation_resolved_var_threshold: 10000.0,
        ),
        // #4357 synthesized active direct-fix tuning: temporal correlation for
        // the truth-relative error process.
        synthesis: (
            smoothing_tau_secs: 1.0,
        ),
        // DC-36.1 measurement-noise SNR scaling (used only when noisy sensing is on).
        noise: (
            snr_reference_db: 15.0,
            snr_scale_min: 0.5,
            snr_scale_max: 6.0,
            min_sigma_m: 0.5,
            range_accuracy_k: 1.4142135,
            monopulse_k: 1.6,
        ),
        // DC-36.2 / DC-1061 bearing-only passive sensors (noisy sensing only).
        bearing: (
            // Large unresolved down-range seed variance (m²): σ ≈ 100 km. The SNR
            // range band (below) is a display/seed prior, not a statistical fix, so
            // the covariance stays large until cross-fix / TMA / active resolves it.
            initial_range_var: 1.0e10,
            // Major-axis variance (m²) above which range is unresolved (σ ≈ 6.3 km).
            bearing_only_var_threshold: 4.0e7,
            // DC-1051: major-axis variance (m²) at or below which a passive
            // elevation angle may be fused (σ ≈ 500 m).
            elevation_range_var_threshold: 2.5e5,
            // DC-1061 SNR → best-guess range mapping (linear in dB between anchors).
            snr_near_range_m: 2000.0,   // strong signal → close
            snr_far_range_m: 60000.0,   // weak signal → far (effective reach)
            snr_strong_db: 30.0,
            snr_weak_db: 3.0,
            // Multiplicative band half-width: near = r_hat/2, far = r_hat*2.
            range_uncertainty_factor: 2.0,
            // DC-1141: published-bearing EMA time constant (s) for range-
            // unresolved contacts — the wire bearing smooths recent live
            // measurements instead of slewing with the raw per-scan noise.
            bearing_smoothing_tau_secs: 5.0,
            // #1729/#1822: a missile's own-seeker LOS uses two decoupled smoothers:
            //   - the published LOS DIRECTION (los_dir): EMA on seeker_gh_dir_tau_secs
            //   - the LOS RATE: an alpha-beta (g-h) tracker (gh_pos + rate state).
            //
            // seeker_gh_dir_tau_secs: EMA time constant (s) for the seeker's
            //   LOS direction output (los_dir). Short so the missile homes on a
            //   fresh bearing during the ~2-3 s closure window. Must be distinct
            //   from bearing_smoothing_tau_secs (5 s, used for the rendered line)
            //   — using 5 s here causes the missile to home on a stale direction
            //   and miss at fine tick rates (100 ms).
            // seeker_gh_rate_tau_secs: rate time constant (s) for the g-h LOS-rate
            //   tracker. The g/h gains are DERIVED from dt and this τ
            //   (critically-damped Kalata: θ=exp(-dt/τ), g=1-θ², h=(1-θ)²), NOT
            //   fixed constants — fixed gains make rate noise scale as σ/dt and
            //   blow up at fast scan rates / fine ticks (#1822). Larger τ →
            //   smoother (lower-noise) but laggier rate. dt-invariant by
            //   construction: the engine must support any sensor scan rate and
            //   variable dt.
            // #2197: both τ shortened 0.3 → 0.1. Against a fast crossing target the
            //   terminal LOS rate accelerates (∝ closing/range) faster than a 0.3 s
            //   tracker follows — it reported ~15% of the true rate near CPA, so the
            //   missile under-led and missed by ~30 m (outside the 10–20 m fuze). At
            //   0.1 s the estimate keeps up and the bearing-only IR intercept kills
            //   with margin across the tick range. Only the own-seeker terminal-homing
            //   LOS uses these (strong, close-range signal → little noise penalty); the
            //   rendered team-track line still uses bearing_smoothing_tau_secs (5 s).
            seeker_gh_dir_tau_secs: 0.1,
            seeker_gh_rate_tau_secs: 0.1,
        ),
        // DC-1053 batch pseudo-linear TMA velocity solver (noisy sensing only).
        tma: (
            // Bearing-history window (s). The CV assumption must hold across it.
            // 8 s (#3870), down from 30: ~3× tighter horizontal error on both
            // active and passive geometry, and ~4× cheaper per solve.
            window_secs: 8.0,
            // Hard cap on retained bearings per track (oldest dropped first).
            // 128 (#3870), down from 256: identical bearing-only observability
            // to 256 rows, at −20% fleet tick cost.
            max_measurements: 128,
            // Hard cap on FDOA pairs emitted per track per scan. Candidates
            // grow as N²/2 in the observer count; the most informative are
            // kept (largest baseline per unit noise).
            max_fdoa_pairs_per_scan: 8,
            // Velocity covariance major eigenvalue ((m/s)²) at/below which
            // velocity reads Resolved (σ ≈ 40 m/s). Above it, velocity is Unknown.
            velocity_resolved_var_threshold: 1600.0,
            // Reduced-χ² per DOF above which a maneuver is inferred and the
            // window is flushed (~3σ).
            maneuver_residual_chi2: 9.0,
            // Reduced-χ² per DOF of the measurements arrived SINCE the last
            // solve, scored against the dead-reckoned state, above which a
            // solve is forced early. Set below maneuver_residual_chi2: this
            // decides only whether to solve, never whether to flush, so a
            // false positive costs one solve. 6.0 is the measured knee (#3866)
            // — full p95 parity with solving on every refresh at ~73% of its
            // solve count; below ~4 it fires on every scan.
            maneuver_innovation_chi2: 6.0,
            // Solve interval (s) a track falls back to while the gate above
            // says its model is broken. A DECIMATOR on maneuver-driven solves,
            // effective only above the scan cadence: the gate needs a row newer
            // than the last solve, so 0.25 and 0.5 measure identically (#3866).
            // 0.5 matches the fastest search sensor's scan_interval, so no scan
            // is skipped; 1.0 halves the fleet cost by skipping every other
            // scan on those sensors.
            maneuver_solve_interval_secs: 0.5,
            // Backstop interval (s) between full batch solves for a converged,
            // un-contradicted Picture-tier track — the only schedule left once
            // the solve-on-demand triggers (first fix, unconverged, innovation
            // gate) have had their say. Bounds slow sub-χ² drift accumulation.
            // <= 0.0 solves on every refresh — the v0.0.4-equivalent baseline
            // proxy the measurement harness uses. 5.0 (#3866, up from 2.0): the
            // unconditional per-refresh solve is gone, so the earlier triggers
            // now cover what a shorter unconditional interval used to.
            picture_backstop_secs: 5.0,
            // A track is Strict-tier when a weapon in flight guides on it via
            // the team track with time-to-go at or below this (s); Strict
            // solves on every refresh. Non-closing weapons never qualify.
            strict_eta_secs: 10.0,
            // Picture-tier unconverged threshold: horizontal position σ (m)
            // above which a refreshed track re-solves immediately. Half the
            // LARGEST warhead blast radius (150 m) — comfortably inside the
            // 70-150 m family with linear falloff, validated by the #3866
            // measured campaign.
            picture_position_sigma_m: 75.0,
            // Marginal information gain below which a row is not admitted to a
            // solve (#3871). A row scores w·hᵀN⁻¹h against the rows already in:
            // the fraction by which it grows the information along its own
            // direction. Rows are taken highest-first until the best remaining
            // one falls below this AND the fit has resolved, so the row count
            // and time span a solve uses follow the geometry instead of
            // window_secs/max_measurements. Never drops a row while the fit is
            // still short of resolving. 0.05 is measured net-cheaper per solve; 0.0 admits
            // everything (the pre-#3871 baseline arm).
            min_row_information_gain: 0.05,
        ),
        // DC-36.3 formation merging (used only when noisy sensing is on).
        clustering: (
            // Split cell = merge cell × this. The dead band stops formations
            // flickering between one merged track and several split tracks.
            split_hysteresis: 1.5,
        ),
        // DC-36.5 contact classification (used only when noisy sensing is on).
        classification: (
            // A single chassis must hold this much mass to be "converged"
            // (solid outline). Below it, the outline stays dashed.
            converge_threshold: 0.7,
            // Subtree mass an NTDS node needs to be the displayed symbol.
            // Lower than converge_threshold, so the shape resolves before the
            // outline goes solid.
            ntds_project_threshold: 0.6,
            // Largest indistinguishable cluster before the verdict is "Open".
            max_cluster: 4,
            // Log-likelihood floor below the leader — a rejected chassis can
            // recover, so absence is never permanently asserted.
            ll_floor: 20.0,
            // Per-look penalty for a wrong environment (air/surface/subsurface).
            // Large, so the generic environment node resolves on the first
            // position-fixed look. Bearing-only contacts contribute none.
            env_penalty: 8.0,
            // Mass lead the top environment branch needs over the runner-up
            // before ANY node below the root may project (#2765). Subtree mass
            // conflates "fits better" with "has more chassis authored near this
            // size" — a size-only look at a 10m usv_80 cannot separate it from a
            // 10m mq_220, yet air led 0.667/0.333 on chassis COUNT and stamped a
            // confident Air on a ship. Both honest routes clear 0.9 by an order
            // of magnitude: env_penalty crushes the rival branch to ~3e-4, and a
            // decisive size (nothing 90m flies) pins the leader at ~1.0.
            env_discrimination_margin: 0.9,
            // Per-look bonus for a matching observed kinematic bucket. Soft, so
            // physics leaves (helicopter / fixed-wing / missile) resolve over
            // several looks.
            kin_weight: 0.6,
            // Observed-speed (m/s) thresholds that bucket airborne/subsurface
            // contacts: <= heli_max → helicopter, >= missile_min → missile,
            // else fixed-wing; subsurface >= torpedo_min → torpedo, else sub.
            heli_max_speed_mps: 80.0,
            missile_min_speed_mps: 300.0,
            torpedo_min_speed_mps: 25.0,
            // Schmitt dead-band (>1) on the speed-bucket thresholds (#2480): a
            // bucket is entered at its bare threshold (prompt upgrades — the
            // inbound-missile alarm still fires at once) but only left once speed
            // clears the threshold by this factor. Stops a track whose speed
            // straddles a threshold from flapping its class (and, across the
            // missile boundary, re-firing the auto-pause alarm) every scan.
            speed_bucket_hysteresis: 1.2,
            // Above this speed a contact cannot be Surface or Subsurface no
            // matter what its altitude reads (#2386) — kinematics dominate
            // altitude. ~5.7x headroom over the fastest surface hull (USV-80,
            // 17.4 m/s), same scale as heli_max_speed_mps.
            surface_max_speed_mps: 100.0,
            // Size (length) likelihood σ as a fraction of observed length.
            size_sigma_frac: 0.2,
            // Floor on size σ (m).
            min_size_sigma_m: 1.0,
            // Acoustic likelihood σ, in log10(sonar-noise) units.
            acoustic_sigma_log: 0.5,
            // DC-36.6 platform-signature channel. Penalty for a candidate whose
            // physics bucket disagrees with a capable sensor's signature read —
            // env-scale, so a capable read overrides the speed-derived bucket.
            signature_bucket_penalty: 8.0,
            // Bonus (match) / penalty (mismatch) for a candidate's propulsion
            // class vs the signature read — narrows same-bucket hulls.
            signature_match_weight: 1.0,
        ),
        // DC-946.1 fire-control lock tuning (cued-lock pass in run_detection).
        fire_control: (
            // Seconds after a lock goes Lost at which the designation is dropped.
            // (The acquisition dwell is per-sensor: SensorDef.acquire_dwell_secs.)
            lock_drop_after_secs: 3.0,
        ),
    ),
    sectors: (
        access_fraction: 0.667,
        min_carrier_separation_deg: 5.0,
    ),
    intercept: (
        fallback_standoff_range: 3000.0,
        min_standoff_range: 500.0,
        max_standoff_range: 10000.0,
        // Pull the standoff orbit inside the kinematic firing envelope so the
        // launch gate can release: the orbit ceiling is the weapon's static
        // max_range, but the gate fires on the (slightly shorter, speed-
        // dependent) kinematic reach. Without margin the launcher parks just
        // outside its own reach and fires nothing (#2212).
        standoff_reach_margin: 0.95,
        // #2984: withhold this fraction of a CRUISE weapon's reach (torpedoes)
        // as maneuver allowance — the no-escape solve assumes a straight-running
        // target, so without slack an evading one runs the weapon dry. Withheld
        // from the standoff ceiling too, so the launcher never parks outside its
        // own firing envelope. Air (boost-coast) munitions are unaffected.
        cruise_maneuver_allowance: 0.35,
        standoff_adjust_rate: 100.0,
        dead_band_db: 2.0,
        search_radial_speed_fraction: 0.1,
        search_duration_seconds: 240.0,
        search_spiral_start_radius_m: 500.0,
        bda_orbit_radius: 1500.0,
        // #2604: while pressing an Engage, the shooter climbs toward a target
        // more than this many metres ABOVE it (raise-only, capped at its own
        // ceiling) so it closes the vertical geometry — the slant range shrinks
        // into the weapon's reach envelope instead of the shooter orbiting
        // laterally below the target forever. Below this delta the vertical
        // barely degrades the slant, so no climb is commanded.
        climb_to_target_min_delta_m: 1000.0,
        // #2685: a screen only closes-to-identify a *closing* Unknown it can
        // actually run down. A contact faster than this (m/s) — a ~600 m/s
        // missile inbound — it cannot meaningfully close on, so it holds station
        // and fires the instant IFF resolves via the defend-anchor scan instead
        // of chasing. Sized above a fast surface craft / slow drone, below any
        // missile or strike aircraft.
        interrogation_max_chase_speed_mps: 60.0,
        // Must stay well below the time a launcher legitimately spends closing
        // while range-blocked before its FIRST shot — measured at 32.8s in
        // arena::scenarios::multi_target_engagement (#3504). It only applies
        // after a round has already been expended, so it need only outlast the
        // gap between a munition dying and a fresh fix.
        range_block_abort_seconds: 10.0,
        // #4657: target-aware salvo sizing. A launcher under the TargetSized
        // doctrine raises its blueprint salvo count to what the *identified*
        // target's catalogued hull actually needs, so one number no longer has
        // to serve both a carrier and a picket.
        salvo: (
            // Fraction of a warhead's nominal damage a round is assumed to
            // land. Covers the two things the sizing arithmetic cannot see:
            // blast falloff (damage scales linearly to zero across
            // blast_radius, so an off-centre detonation lands well under the
            // rated number) and en-route attrition to point defences.
            //
            // MEASURED (#4690, 14 engagements, all five shipped warheads,
            // three target classes, four geometry families; derivation and
            // full table in docs/plans/4690-expected-damage-fraction-
            // calibration.md). Damage was attributed to individual
            // DETONATIONS — the target's hit-point delta per tick against
            // that tick's WeaponEvent::Hit — not to a window close, which is
            // what made #4657's first reading look like 0.36.
            //
            //   pooled delivered / (rounds fired x nominal) .... 0.882
            //   median per engagement .......................... 0.994
            //   range across engagements ....................... 0.55 - 1.00
            //   same, under the shipped Noisy sensing model .... 0.69 - 0.79
            //
            // The 0.55 floor excludes one outlier: mk_40 against a target
            // crossing at 90 m/s read 0.35 per hit and 0.04 per round FIRED,
            // because 7 of its 8 rounds were expended chasing without ever
            // detonating. That is an engagement-envelope failure rather than a
            // delivered-damage one, so it is tracked as #4721 and deliberately
            // not averaged into the figures above — but a derate raised toward
            // the pooled value would be wrong for exactly that engagement.
            //
            // 0.7 is therefore NOT a measured mean; it is deliberately below
            // one. The asymmetry is the reason: asking for too few rounds
            // wastes the whole salvo, asking for too many wastes only the
            // margin — the same trade the cluster case already takes when it
            // sizes against its hardest candidate. It also keeps headroom for
            // the one term the measurement could NOT reach: en-route attrition
            // to point defences never fired in any staged engagement, so the
            // honest value could still sit below the numbers above.
            //
            // Deliberately one flat derate, and the measurement strengthens
            // that rather than weakening it. The dominant variable is target
            // motion relative to the round's terminal performance, not the
            // warhead: mk_120 alone spans 0.55 (target crossing at 90 m/s) to
            // 1.00 (stationary), which is wider than the spread BETWEEN
            // warheads at a fixed geometry. A per-warhead derate would be
            // actively wrong. The launcher cannot predict the missing variable
            // either — it knows a contact's present speed, not whether it will
            // manoeuvre during the round's time of flight.
            //
            // Coincidence worth not over-reading: 0.7 is also almost exactly
            // the fuze-limited floor for mk_40 (1 - 20/70 = 0.71) and mk_120
            // (1 - 30/100 = 0.70) — what a round delivers detonating at the
            // very edge of its proximity fuze ball. As a claim about blast
            // falloff alone, 0.7 was never optimistic; it was the pessimistic
            // end of that band.
            //
            // Raise toward 1.0 for smaller salvos (more likely to under-kill);
            // lower for larger ones. Do NOT expect lowering it to put more
            // rounds on a hard target — see commit_limits below for why it
            // cannot.
            expected_damage_fraction: 0.7,
            // Ceiling on the DERIVED count only — the player's own configured
            // salvo floor is applied afterwards and is never capped by this.
            // Without it a single identified capital hull sizes a salvo larger
            // than any magazine: a cv_3000 (1500 hp) against the small air
            // warhead (mk_40, 65 damage) derives 33 rounds at the derate above.
            // Capping makes that target take repeated admissions, so the
            // launcher re-checks range, aspect and the commitment limit between
            // waves instead of committing everything on one tick.
            max_derived_salvo: 8,
        ),
        // #4688: fleet-wide cap on weapons in flight against a single contact —
        // moved off `Doctrine` because no player or AI can ever set it
        // (`max_engagers`, the platform-COUNT coordination cap, stays on
        // Doctrine — it is genuine per-commander policy). Regular contacts and
        // command ships get independent caps, mirroring `Doctrine::limits_for`'s
        // per-class split.
        //
        // #4690 re-checked the interaction with `salvo` above and found the
        // pair does NOT need to move together, contrary to what this comment
        // and #4657's claimed. This cap already binds wherever the derate
        // would otherwise have mattered: a cv_3000 (1500 hp) saturates
        // `max_derived_salvo` (8) with EVERY shipped warhead at the current
        // derate, so lowering the derate cannot add a single round against a
        // capital hull. What it does change is the soft and medium hulls,
        // where `regular` then truncates most of the increase anyway — at a
        // derate of 0.4 the mk_40 rows ask for 5-7 rounds against hulls this
        // cap holds at 4. Under-commitment against hard targets is real, but
        // its causes are `max_derived_salvo` and magazine depth.
        commit_limits: (
            regular: Limited(4),
            // Command ships are the game-ending win-condition target, so there
            // is no committed-attacker cap on them (#2638): a commander may
            // saturate a carrier's defenses with unlimited weapons in flight.
            command_ship: Unlimited,
        ),
    ),
    patrol: (
        min_radius: 500.0,
        boundary_buffer: 100.0,
    ),
    servicing: (
        auto_rtb_safety_margin: 1.2,
        low_fuel_check_threshold: 0.6,
        bingo_reserve_fuel_fraction: 0.15,
        recovery_pattern_overhead_m: 6000.0,
        rtb_divert_hysteresis_kg: 100.0,
        // #4628: how the RTB carrier ranking trades a deck's emptiness against
        // the distance to reach it. A returner will fly up to 5 km further per
        // extra free slot (a slot = its own weight), and at most 3 slots' worth
        // = 15 km in total, to reach an emptier deck. Sized against the ~50 km
        // map radius: a nearer adequate deck wins in the ordinary case, while a
        // deck with almost no room is still passed over for a farther one.
        rtb_headroom_slot_worth_m: 5000.0,
        rtb_headroom_saturation_slots: 3.0,
        refuel_rate_kg_per_second: 5.0,
        fuel_order_quantity_kg: 500.0,
        fuel_order_cost: 50000.0,
        transfer_rate_kg_per_second: 3.0,
        drone_transfer_seconds: 30.0,
        cost_to_seconds_rate: 0.000005,
    ),
    acoustic: (
        critical_angle_deg: 8.0,
        max_layer_loss_db: 22.0,
        min_layer_loss_db: 3.0,
        shallow_water_k: 8.0,
        shallow_water_p: 2.0,
        shallow_water_max_depth: 1500.0,
        cz_ref_depth: 3000.0,
        cz_ref_interval_nm: 33.0,
        cz_ref_gain_db: 12.0,
        cz_width_ratio: 0.12,
        cz_falloff_per_ring_db: 4.0,
        cz_q: 1.5,
        cz_min_depth: 300.0,
    ),
    match_end: (
        // Imminent match-end warning thresholds (seconds remaining, strictly
        // descending): T-10min, T-5min, T-1min (DC-1106; T-10min added in #1444
        // for the hour-long default match).
        warning_thresholds_secs: [600, 300, 60],
    ),
    threat_reaction: (
        // #4866: the CEILING of the inbound-alarm radius — what a weapon earns
        // while it is still far enough from its closest approach to turn onto
        // anyone, and the radius wherever no time-to-go was resolved at all.
        missile_cpa_radius_m: 2500.0,
        // #4866: the FLOOR, at closest approach itself. Twice the largest
        // warhead's 150 m blast radius, so track error alone cannot decide the
        // call, plus the ~104 m cross-track excursion the shipped weave makes,
        // so a unit's own evasion cannot clear its own alarm.
        missile_cpa_floor_radius_m: 400.0,
        // #4866: time-to-closest-approach at which the ceiling is reached. The
        // ramp is quadratic (turn authority x time remaining), so this states
        // an implied 42 m/s² of lateral correction — about a fifth of an
        // M-250's turn authority at cruise. Larger keeps the whole formation
        // reacting for longer; the balance knob of the rule.
        missile_cpa_horizon_secs: 10.0,
        // #4866: how much wider an already-raised inbound rung is held before
        // it is released. Without it a unit the shrinking radius drops goes
        // back on mission, drifts back toward the weapon's track and re-alarms,
        // round-tripping through its previous assignment each time. The closest
        // approach is solved in the unit's own frame, so a turning unit's
        // reading swings with its heading and the band is needed at every
        // time-to-go, not only inside the ramp. Bounded by construction at
        // `missile_cpa_radius_m * missile_cpa_stand_down_margin` (3125 m here),
        // which is the widest a held rung ever reaches. Not capped at the
        // ceiling: beyond the horizon the raise radius is already the ceiling,
        // so a cap would leave no dead band where one is most needed.
        missile_cpa_stand_down_margin: 1.25,
        // #3745: how far off a bearing-only track's line of bearing a unit may
        // stand and still weave, expressed in that track's own across-bearing
        // sigma on top of `missile_cpa_radius_m`. Deliberately generous — the
        // gate REJECTS units, so an over-tight cone silences a warning, while an
        // over-wide one only weaves a unit that was never in danger.
        bearing_cone_sigma_admission: 3.0,
        missile_speed_sigma_admission: 2.0,
        lock_clear_hysteresis_secs: 5.0,
        // #3889: how long a raised RWR call is held before it may announce a
        // clear. Matched to `lock_clear_hysteresis_secs` so the announced call
        // and the evade-clear decision relax on the same timescale.
        threat_alert_min_dwell_secs: 5.0,
        // #3713: one bounded evasive reaction per range-unresolved munition
        // track. Sized to cover a full sonar-range torpedo run (~60 s at the
        // engagement ranges a passive array actually detects at), so the reflex
        // outlasts the threat it can see rather than expiring mid-run; the bound
        // exists to stop a permanently-frozen track holding a unit off its
        // assignment forever, not to cut a live reaction short.
        bearing_only_reflex_max_secs: 60.0,
        engagement_commitment_max_secs: 90.0,
    ),
    traffic: (
        // #3705 (epic #3459). Eight hulls on a 100 km-wide theatre is sparse
        // enough that a civilian in the picture is an event rather than
        // scenery, and dense enough that one is usually somewhere.
        target_population: 8,
        population_band: 3,
        // Spawn cadence. The band, not this, decides how much traffic there is;
        // this decides how fast the map fills from empty (~8 spawns at a ~95 s
        // mean gap ≈ 13 min) and how ragged arrivals look once it is full.
        spawn_interval_min_s: 45.0,
        spawn_interval_max_s: 150.0,
        // Target drift. Re-rolled every 4–10 min so traffic thickens and thins
        // across a match instead of pinning to one number.
        target_drift_min_s: 240.0,
        target_drift_max_s: 600.0,
        // Inside the rim, never on it: the playable map is the circle of the
        // terrain radius and a point placed exactly on it is one float step
        // from the off-map water A* refuses to enter (#2271). At the 50 km
        // default radius this is a 1.5 km inset.
        ring_radius_fraction: 0.97,
        // Retirement is positional as well as order-based: a civilian with no
        // active order has either arrived at a rim exit or never had an order,
        // and only the first is an exit. 0.9 of the entry ring leaves ~4.9 km
        // of slack at the default 50 km radius — far more than the loiter a
        // hull settles into on arrival, and far less than the middle of the map
        // where a debug-spawned demo vessel sits.
        retirement_ring_fraction: 0.9,
        // A crossing spans at least a quadrant — ~69 km at the default radius,
        // so a civilian is genuinely transiting the theatre rather than
        // clipping a corner of it.
        min_crossing_separation_deg: 90.0,
        max_placement_attempts: 16,
        // #3886: keep civilians out of the teams' starting anchorages. On the
        // default 50 km map the carriers start at 49.0 km and this ring sits at
        // 48.5 km — 500 m apart — so without this a civilian drawn near a
        // team's angle arrives on top of it. 15 km excludes ~35.4° of ring per
        // team (~20% at 2 teams, ~39% at 4), leaving ample water to draw from.
        start_keep_out_m: 15000.0,
        // #3707: the full six-type roster. Weights are first-pass — flagged
        // for a balance pass once the cast is actually visible in matches.
        mix: [
            (blueprint: "Autonomous Cargo Ship", weight: 3.0, behavior: Cross),
            (blueprint: "Autonomous LNG Tanker", weight: 2.0, behavior: Cross),
            (blueprint: "Autonomous Fishing Vessel", weight: 2.0, behavior: ClusterEscort),
            (blueprint: "Autonomous Factory Trawler", weight: 1.0, behavior: ClusterAnchor),
            // #3460: the two air neutrals chase the action rather than hopping
            // at random — a fresh wreck, then a launch, then a command ship.
            (blueprint: "Peacekeeping Observation Drone", weight: 1.0, behavior: ActionHop),
            (blueprint: "Press War Correspondent Drone", weight: 1.0, behavior: ActionHop),
        ],
        // #3707: orbit-hop / cluster tuning. `orbit_radius_m` is shared by
        // every hop's ring and by a `ClusterAnchor`'s own stationary loiter;
        // 1.5 km is well inside the map footprint at the default 50 km
        // radius (`ring_radius_fraction` above already insets that) and
        // comfortably clears every shipped hull's minimum turn radius.
        orbit_radius_m: 1500.0,
        // "A few laps" — converted to a dwell time per hull from its own
        // cruise speed at roll time (see the field docs), so this range
        // means the same thing for a 5 m/s fishing skiff and a 100+ m/s
        // strike drone alike.
        orbit_hop_min_orbits: 2.0,
        orbit_hop_max_orbits: 5.0,
        // How far a free hop (no cluster anchor to stay near) may range from
        // its current point — a local patch of theatre, not the whole map.
        orbit_hop_radius_m: 8_000.0,
        // A handful of points visited before heading home and freeing the
        // slot — without this cap an orbiting civilian never leaves (see the
        // module docs).
        orbit_hop_visits_min: 2,
        orbit_hop_visits_max: 5,
        // The escort screen stays within 4 km of its trawler.
        cluster_radius_m: 4_000.0,
        // The trawler's own "long loiter" — several times an escort's visit
        // count, so it reads as the parked centre of the cluster rather than
        // leaving on the same schedule as the boats working around it.
        cluster_anchor_visits_min: 20,
        cluster_anchor_visits_max: 40,
        // #3460: how long a wreck or a launch stays newsworthy. Must stay
        // above the SHORTEST dwell or a site always ages out before any
        // on-station drone next chooses, and the behaviour degrades to a plain
        // `OrbitHop` for everything except fresh spawns: at `orbit_radius_m`
        // 1500 m and the two air neutrals' ~60 m/s cruise a lap is ~157 s, so
        // the 2-5 lap dwell spans 314-785 s. Ten minutes clears the short end
        // with room and still reads as news in a match measured in tens of
        // minutes.
        action_recency_s: 600.0,
        // Most of a 100 km-wide theatre, but not all of it: on a large map two
        // press drones on opposite rims converge on different fights.
        action_search_radius_m: 30000.0,
    ),
    territory: (
        // Territory-capture zone radial bounds (#4141): the centre-circle
        // zone is [0, R/3]; the outer ring is (R/3, 3R/4]; beyond 3R/4 is
        // zone-free water.
        //
        // The ring's outer edge was widened from 2R/3 to 3R/4 on #4229 — the
        // maintainer's manual pass found the ring too thin to fight over. The
        // centre disc is unchanged, so the widening is entirely at the ring's
        // expense of the zone-free water outside it.
        inner_radius_fraction: 0.3333333,
        outer_radius_fraction: 0.75,
    ),
)
